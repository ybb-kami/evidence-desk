# Source this file in the shell of the workbench if using a custom model location.
# The local installer defaults to ~/.local/share/evidence-desk/models.
# export EVIDENCE_TRANSLATION_MODELS="/absolute/path/to/models"

# Optional: set DEEPSEEK_API_KEY using the runtime's private credential settings.
# Then launch the workbench with --enable-deepseek for per-request quote selection.

# Optional: exact chat model ID available to your DeepSeek account.
# export DEEPSEEK_MODEL="your-enabled-model-id"
# Optional: enable offline formula candidates with verified local weights.
# export EVIDENCE_FORMULA_PYTHON="/absolute/path/to/formula-env/bin/python"
# export EVIDENCE_FORMULA_WEIGHTS="/absolute/path/to/verified-weights"
